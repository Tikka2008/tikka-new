    "language": "html",
    "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n<title>Price List with Order Buttons</title>\n<!-- Font Awesome for icons -->\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n<style>\n  body {\n    font-family: 'Poppins', sans-serif;\n    background: #121212;\n    color: #f0f0f0;\n    padding: 20px;\n  }\n  h2 {\n    text-align: center;\n    margin-bottom: 20px;\n  }\n  .container {\n    max-width: 600px;\n    margin: 0 auto;\n  }\n  .section {\n    background: rgba(20,20,30,0.85);\n    padding: 20px;\n    border-radius: 15px;\n    margin-bottom: 30px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.5);\n  }\n  .section h3 {\n    margin-bottom: 15px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 1.8rem;\n  }\n  .price-item {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 12px 0;\n    border-bottom: 1px dashed #555;\n  }\n  .price-info {\n    display: flex;\n    flex-direction: column;\n  }\n  .price-label {\n    font-weight: 600;\n  }\n  .price-amount {\n    color: #ffcb05;\n    font-weight: 700;\n  }\n  .order-btn {\n    background: #ff3b3b;\n    border: none;\n    padding: 10px 20px;\n    border-radius: 8px;\n    color: #fff;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.3s;\n  }\n  .order-btn:hover {\n    background: #cc2f2f;\n  }\n  /* Contact Buttons */\n  .contacts {\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    margin-bottom: 30px;\n  }\n  .contact-link {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: linear-gradient(135deg, #8a2be2, #560bad);\n    color: #fff;\n    padding: 15px;\n    border-radius: 50px;\n    font-weight: 700;\n    text-decoration: none;\n    font-size: 1.2rem;\n    box-shadow: 0 5px 15px rgba(86,11,173,0.4);\n    transition: all 0.3s;\n  }\n  .contact-link:hover {\n    transform: translateY(-3px);\n    box-shadow: 0 8px 20px rgba(86,11,173,0.6);\n  }\n  /* Social Icons */\n  .social-icons {\n    display: flex;\n    justify-content: center;\n    gap: 20px;\n    margin-bottom: 30px;\n  }\n  .social-icons a {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 50px; height: 50px;\n    border-radius: 50%;\n    background: rgba(255,255,255,0.1);\n    color: #fff;\n    font-size: 1.5rem;\n    transition: all 0.3s;\n  }\n  .social-icons a:hover {\n    background: var(--primary);\n    transform: translateY(-5px);\n  }\n  /* Footer */\n  footer {\n    text-align: center;\n    font-size: 0.9rem;\n    color: #777;\n    padding: 10px;\n  }\n</style>\n</head>\n<body>\n\n<h2>PRICE LIST WITH ORDER BUTTON</h2>\n\n<div class=\"container\">\n\n  <!-- PRICE LIST -->\n  <div class=\"section\">\n    <h3><i class=\"fas fa-tags\"></i> PRICE LIST</h3>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">1K LIKE + 10K VIEWS</span>\n        <span class=\"price-amount\">LKR 250</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('1K LIKE + 10K VIEWS', 'LKR 250')\">Order</button>\n    </div>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">2K LIKE + 20K VIEWS</span>\n        <span class=\"price-amount\">LKR 500</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('2K LIKE + 20K VIEWS', 'LKR 500')\">Order</button>\n    </div>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">3K LIKE + 30K VIEWS</span>\n        <span class=\"price-amount\">LKR 750</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('3K LIKE + 30K VIEWS', 'LKR 750')\">Order</button>\n    </div>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">4K LIKE + 40K VIEWS</span>\n        <span class=\"price-amount\">LKR 1000</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('4K LIKE + 40K VIEWS', 'LKR 1000')\">Order</button>\n    </div>\n  </div>\n\n  <!-- Combo Offer -->\n  <div class=\"section\">\n    <h3><i class=\"fas fa-gift\"></i> Combo Offer</h3>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">10K LIKE + 50K VIEWS</span>\n        <span class=\"price-amount\">LKR 900</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('10K LIKE + 50K VIEWS', 'LKR 900')\">Order</button>\n    </div>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">50K LIKE + 100K VIEWS</span>\n        <span class=\"price-amount\">LKR 1950</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('50K LIKE + 100K VIEWS', 'LKR 1950')\">Order</button>\n    </div>\n  </div>\n\n  <!-- Followers -->\n  <div class=\"section\">\n    <h3><i class=\"fas fa-users\"></i> TIK TOK FOLLOWERS</h3>\n    <div class=\"price-item\">\n      <div class=\"price-info\">\n        <span class=\"price-label\">1K FOLLOWERS</span>\n        <span class=\"price-amount\">LKR 750</span>\n      </div>\n      <button class=\"order-btn\" onclick=\"sendOrder('1K FOLLOWERS', 'LKR 750')\">Order</button>\n    </div>\n  </div>\n\n  <!-- Contact WhatsApp Buttons -->\n  <div class=\"contacts\">\n    <a class=\"contact-link\" href=\"https://wa.me/94761180276\" target=\"_blank\">\n      <i class=\"fab fa-whatsapp\"></i> WhatsApp: 076 118 0276\n    </a>\n    <a class=\"contact-link\" href=\"https://wa.me/94701986512\" target=\"_blank\">\n      <i class=\"fab fa-whatsapp\"></i> WhatsApp: 070 198 6512\n    </a>\n  </div>\n\n  <!-- Social icons -->\n  <div class=\"social-icons\">\n    <a href=\"https://www.tiktok.com/@tikka_id_top_up_center?_t=ZS-8zusZ0Ox5ZS_r=1\" target=\"_blank\">\n      <i class=\"fab fa-tiktok\"></i>\n    </a>\n    <a href=\"https://whatsapp.com/channel/0029Vb5gle1JUM2RWlaBHX2K\" target=\"_blank\">\n      <i class=\"fab fa-whatsapp\"></i>\n    </a>\n    <a href=\"https://www.facebook.com/share/1JabLH71AJ/?mibextid=wwXIfr\" target=\"_blank\">\n      <i class=\"fab fa-facebook-f\"></i>\n    </a>\n    <a href=\"#\">\n      <i class=\"fab fa-youtube\"></i>\n    </a>\n  </div>\n\n  <!-- Footer -->\n  <footer>\n    ©️ 2025 TIKKA x RASI - TikTok Boosting Store. All rights reserved.\n  </footer>\n</div>\n\n<!-- JavaScript for WhatsApp Order -->\n<script>\n  function sendOrder(description, price) {\n    const message = encodeURIComponent(`Order: ${description}\\nPrice: ${price}\\nFrom TIKKA x RASI`);\n    const phoneNumber = '94761180276'; //   WhatsApp \n    const url = `https://wa.me/${phoneNumber}?text=${message}`;\n    window.open(url, '_blank');\n  }\n</script>\n\n</body>\n</html>"
